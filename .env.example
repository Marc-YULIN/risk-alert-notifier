# Copy to .env and adjust. docker compose reads this file automatically.
# Leave the Telegram values empty to stay in dry-run mode.
Security__IngestApiKey=dev-ingest-key
Notifications__Telegram__BotToken=
Notifications__Telegram__ChatId=
Notifications__Telegram__Locale=en
Notifications__DisplayTimeZone=Asia/Taipei
Dashboard__PublicUrl=http://localhost:5107
